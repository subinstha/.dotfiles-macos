[user]
	name = subin
	email = 48222247+subinstha@users.noreply.github.com
[init]
	defaultBranch = main
[alias]
	staash = stash --include-untracked
[rerere]
	enabled = true
[column]
	ui = auto
[branch]
	sort = -committerdate
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[core]
	excludesfile = /Users/subin/.gitignore_global
	pager = delta
[pull]
	rebase = true
[rebase]
	autoStash = true
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
	line-numbers = true
	syntax-theme = Dracula
[merge]
	conflictstyle = diff3
[diff]
	colorMoved = default
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
