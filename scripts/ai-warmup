#!/usr/bin/env bash

# Sends one tiny prompt to Claude Code and Codex. Both count their 5 hour usage
# window from the first message, so sending it early means the window resets
# sooner in the day. Run by launchd, see launchd/com.subin.ai-warmup.plist.

export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

log="$HOME/Library/Logs/ai-warmup.log"
workdir="$HOME/.cache/ai-warmup"
prompt="Reply with the single word: ok"

mkdir -p "$workdir"
cd "$workdir" || exit 1

# keep the mac awake until this script exits
caffeinate -i -w $$ &

say() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') $*" >> "$log"
}

# macOS has no timeout(1)
with_timeout() {
    perl -e 'alarm shift; exec @ARGV' "$@"
}

# pmset repeat only holds one wake a day, so schedule a wake one minute before
# each later run in the plist. Needs the sudoers rule from install-ai-warmup.sh,
# without it sudo -n fails and the mac just runs the job whenever it next wakes.
plist="$HOME/Library/LaunchAgents/com.subin.ai-warmup.plist"
now=$(date +%s)
i=0
while hour=$(/usr/libexec/PlistBuddy -c "Print :StartCalendarInterval:$i:Hour" "$plist" 2> /dev/null); do
    minute=$(/usr/libexec/PlistBuddy -c "Print :StartCalendarInterval:$i:Minute" "$plist")
    wake=$(($(date -j -f "%H:%M:%S" "$hour:$minute:00" +%s) - 60))
    if [[ $wake -gt $now ]]; then
        at=$(date -r "$wake" "+%m/%d/%y %H:%M:%S")
        if sudo -n /usr/bin/pmset schedule wake "$at" 2> /dev/null; then
            say "wake scheduled for $at"
        fi
    fi
    i=$((i + 1))
done

# wifi takes a few seconds to come back after a scheduled wake
online=0
for _ in $(seq 1 30); do
    if curl -s -o /dev/null --max-time 5 https://api.anthropic.com; then
        online=1
        break
    fi
    sleep 2
done

if [[ $online -eq 0 ]]; then
    say "no network, skipping"
    exit 1
fi

status=0

# --setting-sources project keeps user hooks and plugins out, and $workdir has
# no project settings. Login still comes from the keychain.
if out=$(with_timeout 120 claude -p "$prompt" \
    --model haiku \
    --setting-sources project \
    --strict-mcp-config \
    --tools "" \
    --no-session-persistence < /dev/null 2>&1); then
    say "claude ok: $(echo "$out" | tail -n 1)"
else
    say "claude FAILED: $(echo "$out" | tail -n 3 | tr '\n' ' ')"
    status=1
fi

if out=$(with_timeout 120 codex exec "$prompt" \
    --skip-git-repo-check \
    --ephemeral \
    --ignore-user-config \
    --sandbox read-only \
    -c model_reasoning_effort=low < /dev/null 2>&1); then
    say "codex ok: $(echo "$out" | tail -n 1)"
else
    say "codex FAILED: $(echo "$out" | tail -n 3 | tr '\n' ' ')"
    status=1
fi

exit $status
