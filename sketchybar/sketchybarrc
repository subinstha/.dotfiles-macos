#!/usr/bin/env zsh

SKETCHYBAR_CONFIG="$HOME/.config/sketchybar"

# The bar always lives on the built-in laptop panel regardless of how many
# external monitors are attached, so the laptop config is the only one used.
# It figures out which arrangement index the built-in currently is; see
# plugins/bar_display.sh. sketchybarrc-desktop is kept around but unused.
source "$SKETCHYBAR_CONFIG/sketchybarrc-laptop"
